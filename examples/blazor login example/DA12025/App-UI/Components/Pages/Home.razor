@page "/"
@using System.Text.Json
@using Services
@using Services.Models

@inject SessionService SessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

@if (_user != null)
{
    <h1>Home Screen</h1>
    <p>This is a Movie App created with Blazor</p>
    <div>
        <h5 class="mt-4">Welcome @_user.Email</h5>
        <div class="mt-4">
            <button type="button" class="btn btn-secondary" @onclick="OnLogout">Logout</button>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center mt-lg-4">
        <div>
            <div class="d-flex justify-content-center align-items-center">
                <h1>Blazor App</h1>
            </div>
            <div class="d-flex justify-content-center align-items-center">
                <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                    <button type="button" class="btn btn-primary" style="min-width: 120px;">Login</button>
                </NavLink>
            </div>
        </div>
    </div>
}

@code {
    private LoggedUserDTO? _user;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "user");
        if (!string.IsNullOrEmpty(json))
        {
            _user = JsonSerializer.Deserialize<LoggedUserDTO>(json);
            StateHasChanged(); //refresh UI after loading user
        }
    }

    private async Task OnLogout()
    {
        SessionService.Logout();
        await JS.InvokeVoidAsync("localStorage.removeItem", "user");
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

}
